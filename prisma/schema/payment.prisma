model Payment {
  id       String        @id @default(uuid())
  status   PaymentStatus @default(UNPAID)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("BDT")

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // bkash
  paymentGateway        String  @default("bkash")
  merchantInvoiceNumber String  @unique // appointment id
  bkashPaymentId        String? @unique
  bkashTrxId            String? @unique
  payerReference        String? //users email or phoneNo
  paidAt                String?
  gatewayResponse       Json?

  //   refund
  refundTrxId  String?
  refundAmount String?
  refundReason String?
  refundedAt   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
