		{
			"name": "05 · Appointment",
			"description": "`/api/v1/appointment`. Booking creates a PENDING appointment plus an UNPAID bKash payment and returns the bKash checkout URL.",
			"item": [
				{
					"name": "Book Appointment (Patient)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduleId\": \"{{scheduleId}}\"\n}" },
						"url": { "raw": "{{apiUrl}}/appointment/booking", "host": ["{{apiUrl}}"], "path": ["appointment", "booking"] },
						"description": "PATIENT only. Creates the appointment + payment rows in one transaction and calls bKash `tokenized/checkout/create` (amount is hard-coded to 500 BDT).\n\n`data` is the bKash checkout URL — open it in a browser to complete the sandbox payment. Requires working BKASH_* env vars."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const url = pm.response.json().data;",
									"if (typeof url === 'string') console.log('Open the bKash checkout URL:', url);"
								]
							}
						}
					]
				},
				{
					"name": "Pay Appointment (retry payment)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}" },
						"url": { "raw": "{{apiUrl}}/appointment/pay", "host": ["{{apiUrl}}"], "path": ["appointment", "pay"] },
						"description": "PATIENT only. Re-initiates bKash checkout for an existing unpaid appointment and returns a fresh checkout URL."
					}
				},
				{
					"name": "bKash Callback (gateway redirect)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiUrl}}/appointment/callback/bkash?paymentID=TR0011xxxxxxx&status=success&signature=abc123",
							"host": ["{{apiUrl}}"],
							"path": ["appointment", "callback", "bkash"],
							"query": [
								{ "key": "paymentID", "value": "TR0011xxxxxxx", "description": "Required — from bKash." },
								{ "key": "status", "value": "success", "description": "success | failure | cancel" },
								{ "key": "signature", "value": "abc123", "description": "Required — from bKash." }
							]
						},
						"description": "Public. bKash redirects the browser here after checkout; the handler executes the payment, confirms the appointment and 302-redirects to the frontend.\n\nYou normally do not call this by hand — it is here for inspection and for replaying a callback. All three query params are required or it 400s. Turn off \"Automatically follow redirects\" in Postman settings to see the 302."
					}
				},
				{
					"name": "Cancel Appointment (Patient)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}" },
						"url": { "raw": "{{apiUrl}}/appointment/cancel", "host": ["{{apiUrl}}"], "path": ["appointment", "cancel"] },
						"description": "PATIENT only. Cancels the appointment and initiates a bKash refund, subject to the cancellation window enforced in the service."
					}
				},
				{
					"name": "Update Appointment Status (Doctor)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"ONGOING\",\n  \"appointmentId\": \"{{appointmentId}}\"\n}" },
						"url": { "raw": "{{apiUrl}}/appointment/update", "host": ["{{apiUrl}}"], "path": ["appointment", "update"] },
						"description": "DOCTOR only. `status`: `ONGOING` | `COMPLETED`. The appointment must be CONFIRMED or ONGOING — PENDING, COMPLETED and CANCELED are rejected by the service.\n\n⚠️ Backend bug: the route is `/update` with no URL param, but the controller reads `req.params.appointmentId`, so the id is always `undefined` and this returns 404 \"Appointment not found\". Fix by changing the route to `/update/:appointmentId` (then use the next request) or by reading `appointmentId` from the body — the body here already carries it for the latter case."
					}
				},
				{
					"name": "Update Appointment Status — :appointmentId variant (after fix)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\"\n}" },
						"url": { "raw": "{{apiUrl}}/appointment/update/{{appointmentId}}", "host": ["{{apiUrl}}"], "path": ["appointment", "update", "{{appointmentId}}"] },
						"description": "Use this once the route becomes `router.patch('/update/:appointmentId', ...)`. Against the current code it 404s at the router."
					}
				},
				{
					"name": "My Appointments (Patient)",
					"request": {
