								{ "key": "sortOrder", "value": "desc" },
								{ "key": "status", "value": "", "description": "PENDING | CONFIRMED | CANCELED | ONGOING | COMPLETED" }
							]
						},
						"description": "PATIENT only. Captures the first appointment id into `appointmentId`."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const d = pm.response.json().data || {};",
									"const list = d.data || d.appointments || (Array.isArray(d) ? d : []);",
									"if (Array.isArray(list) && list.length) {",
									"  pm.collectionVariables.set('appointmentId', list[0].id);",
									"  console.log('appointmentId saved', list[0].id);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Doctor Appointments (Doctor)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiUrl}}/appointment/doctor-appointments?page=1&limit=10&sortBy=createdAt&sortOrder=desc&status=",
							"host": ["{{apiUrl}}"],
							"path": ["appointment", "doctor-appointments"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "sortBy", "value": "createdAt" },
								{ "key": "sortOrder", "value": "desc" },
								{ "key": "status", "value": "", "description": "PENDING | CONFIRMED | CANCELED | ONGOING | COMPLETED" }
							]
						},
						"description": "DOCTOR only."
					}
				},
				{
					"name": "Single Appointment",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{apiUrl}}/appointment/single-appointment/{{appointmentId}}", "host": ["{{apiUrl}}"], "path": ["appointment", "single-appointment", "{{appointmentId}}"] },
						"description": "PATIENT or DOCTOR.\n\n⚠️ Backend bug: the route declares `:id` but the controller reads `req.params.appointmentId` → always `undefined` → 404. Rename the route param to `:appointmentId` (or the controller to `req.params.id`) to make this work."
					}
				},
				{
